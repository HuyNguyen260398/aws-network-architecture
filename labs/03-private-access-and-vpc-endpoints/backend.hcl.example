# Copy to backend.hcl and fill in the bucket. backend.hcl is gitignored, because
# the bucket name is specific to your AWS account.
#
#   cp backend.hcl.example backend.hcl
#   terraform init -backend-config=backend.hcl
#
# Get the values from the bootstrap module:
#
#   terraform -chdir=../../bootstrap output -raw state_bucket_name
#   terraform -chdir=../../bootstrap output -raw state_bucket_region
#
# The state key for this lab is set in backend.tf and must not be repeated here.

bucket = "REPLACE-ME-see-bootstrap-output-state_bucket_name"

# An S3 backend is Region-specific. This must match the Region the state bucket
# was created in, which is not necessarily the Region this lab deploys into.
region = "ap-southeast-1"

encrypt      = true
use_lockfile = true

# Only if bootstrap was applied with create_kms_key = true:
# kms_key_id = "arn:aws:kms:ap-southeast-1:111122223333:key/00000000-0000-0000-0000-000000000000"
