# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

aws_region   = "ap-southeast-1"
project_name = "awsnet"

# ---------------------------------------------------------------------------
# Address planning -- the part that cannot be fixed later
# ---------------------------------------------------------------------------
# These three ranges must not overlap. Terraform validates it here; AWS would
# reject the peering connection outright, and the only remedy at that point is
# to rebuild a VPC. Try setting vpc_b_cidr = "10.40.0.0/16" to see the error.
vpc_a_cidr = "10.40.0.0/16"
vpc_b_cidr = "10.41.0.0/16"
vpc_c_cidr = "10.42.0.0/16"

subnet_newbits = 8

# The third VPC is what makes this a lesson rather than a demo: it is peered
# with A, and still cannot reach B.
enable_vpc_c = true

# ---------------------------------------------------------------------------
# The fix, and its cost in complexity
# ---------------------------------------------------------------------------
# Leave false first. Confirm B cannot reach C. Then turn it on and watch a full
# mesh work -- and note that n VPCs need n(n-1)/2 connections. Ten VPCs is
# forty-five connections and ninety route entries, hand-maintained. That is the
# argument for Transit Gateway (lab 05).
enable_b_to_c_peering = false

# ---------------------------------------------------------------------------
# Test instances -- ~USD 0.031/hour for three (USD 0.75/day)
# ---------------------------------------------------------------------------
# One per VPC. Peering connections themselves are free; these are the only
# charges in the lab. Set false to inspect route tables at zero cost.
enable_test_instances = true

# additional_tags = {
#   Owner = "your-name"
# }
