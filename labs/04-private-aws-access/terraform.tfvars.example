# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
#
# Every lab shares one state, so carry your terraform.tfvars forward from lab to
# lab and add the new settings each lab introduces.

aws_region   = "ap-southeast-1"
project_name = "shop"

vpc_cidr = "10.10.0.0/16"

# ---------------------------------------------------------------------------
# Lab 01 -- single server
# ---------------------------------------------------------------------------
# Who may reach the shop from the internet. 0.0.0.0/0 is everyone; narrow it to
# "203.0.113.7/32" (your own address) if you prefer.
allowed_client_cidr = "0.0.0.0/0"

# Second layer of filtering, on the host itself (nftables).
enable_host_firewall = true

# Optional: an existing Route 53 PUBLIC hosted zone you own. Creates
# shop.<zone> pointing at the shop. Leave null to use the AWS-assigned name.
# public_zone_name = "example.com"

# ---------------------------------------------------------------------------
# Lab 02 -- segmentation
# ---------------------------------------------------------------------------
# No new settings. The single server becomes three, one per tier. Three
# t4g.nano instances and one public IPv4 address: about USD 0.021/hour.

# ---------------------------------------------------------------------------
# Lab 03 -- NAT gateway. OFF by default. ~USD 43/month EACH plus ~USD 0.059/GB.
# ---------------------------------------------------------------------------
# Turning this on gives the app and database hosts outbound internet access,
# which is what lets their SSM agents register. Both flags are required.
#
# Turn it on, run the exercises, then turn it off again.
#
# acknowledge_costs  = true
# enable_nat_gateway = true
#
# "single" = one gateway shared by every AZ (cheapest).
# "per_az" = one per AZ (survives a zone failure, costs twice as much).
nat_gateway_mode = "single"

# IPv6 -- free. Gives the private tiers outbound access through an egress-only
# internet gateway at zero cost.
enable_ipv6                         = false
enable_egress_only_internet_gateway = true

# ---------------------------------------------------------------------------
# Lab 04 -- VPC endpoints
# ---------------------------------------------------------------------------
# The S3 gateway endpoint is free and on by default.
enable_s3_gateway_endpoint          = true
restrict_s3_endpoint_to_shop_bucket = true

# Interface endpoints for Session Manager. OFF by default. ~USD 0.033/hour
# (~USD 24/month) for the three. With these on you can turn the NAT gateway off
# and still get a shell on the private hosts.
#
# acknowledge_costs          = true
# enable_interface_endpoints = true

# additional_tags = {
#   Owner = "your-name"
# }
