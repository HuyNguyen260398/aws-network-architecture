# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
#
#   cp terraform.tfvars.example terraform.tfvars

aws_region   = "ap-southeast-1"
project_name = "awsnet"

# Plan this before you type it: a VPC CIDR cannot be changed after creation, and
# two VPCs with overlapping ranges can never be peered. The labs in this
# repository use a different /16 each so they can all coexist and be connected:
#
#   lab 01  10.10.0.0/16
#   lab 02  10.20.0.0/16
#   lab 03  10.30.0.0/16
#   lab 04  10.40.0.0/16 and 10.41.0.0/16 and 10.42.0.0/16
#   lab 05  10.50.0.0/16 ...
vpc_cidr = "10.10.0.0/16"

# One public and one private subnet per Availability Zone.
az_count = 2

# 8 added to a /16 gives /24 subnets. Try 4 (for /20s) or 10 (for /26s) and run
# `terraform plan` to see how the carving changes.
subnet_newbits = 8

# Leave these empty to derive subnet CIDRs from vpc_cidr. Set them to take full
# control -- useful when you have to fit into an address plan someone else owns.
# public_subnet_cidrs  = ["10.10.0.0/24", "10.10.1.0/24"]
# private_subnet_cidrs = ["10.10.128.0/24", "10.10.129.0/24"]

# Free, and worth turning on once. IPv6 has no NAT, no private ranges, and no
# address-space planning -- Amazon assigns the /56 and every address is globally
# routable, with reachability controlled purely by routing and firewalls.
enable_ipv6 = false

# additional_tags = {
#   Owner = "your-name"
# }
