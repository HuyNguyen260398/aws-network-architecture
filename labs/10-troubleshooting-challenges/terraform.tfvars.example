# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
#
# THIS LAB DEPLOYS DELIBERATELY BROKEN INFRASTRUCTURE.

aws_region   = "ap-southeast-1"
project_name = "awsnet"

base_vpc_cidr  = "10.100.0.0/16"
peer_vpc_cidr  = "10.101.0.0/16"
subnet_newbits = 8

# ---------------------------------------------------------------------------
# Pick ONE. Diagnose it. Destroy. Repeat.
# ---------------------------------------------------------------------------
# Interacting faults are realistic and a poor way to learn. A check block warns
# if you enable more than two at once.
#
#   missing-route         Peering active, route on one side only
#   overlapping-cidr      Two VPCs that cannot be peered -- work out why
#   security-group        A rule with the wrong source
#   nacl-ephemeral        Outbound works, replies vanish
#   broken-dns            A correct record that resolves for nobody
#   endpoint-policy       An endpoint policy that omits the bucket you need
#   missing-association   An endpoint attached to the wrong route table
#   asymmetric-routing    Two identical-looking subnets, one broken
#   flow-log-rejects      Find the drop using flow logs
challenges = ["missing-route"]

# ---------------------------------------------------------------------------
# Test instances -- ~USD 0.016/hour (USD 0.026 when a peer VPC is needed)
# ---------------------------------------------------------------------------
# Without them you can read configuration but cannot observe symptoms, which is
# most of the exercise.
enable_test_instances = true

flow_log_retention_days = 1

# additional_tags = {
#   Owner = "your-name"
# }
