#!/bin/bash
set -u

mkdir -p /opt/shop
echo '${app_b64}' | base64 -d > /opt/shop/app.py

%{ for name, svc in services ~}
cat > /etc/systemd/system/shop-${name}.service <<'UNIT'
[Unit]
Description=Shop stand-in service ${name} on TCP ${svc.port}
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/shop/app.py ${name} ${svc.port} ${svc.upstream_url == null ? "" : svc.upstream_url}
Restart=always

[Install]
WantedBy=multi-user.target
UNIT
systemctl enable --now shop-${name}.service

%{ endfor ~}
%{ if firewall_ports != null ~}
# Host firewall. The security group already filters at the network interface;
# this is the second, independent layer, enforced by the host's own kernel.
if dnf install -y nftables; then
  cat > /etc/sysconfig/nftables.conf <<'NFT'
flush ruleset
table inet shop {
  chain input {
    type filter hook input priority 0; policy drop;
    iif "lo" accept
    ct state established,related accept
    meta l4proto { icmp, ipv6-icmp } accept
    tcp dport { ${join(", ", firewall_ports)} } accept
  }
}
NFT
  systemctl enable --now nftables.service
fi
%{ endif ~}
