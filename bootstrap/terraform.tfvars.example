# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
#
#   cp terraform.tfvars.example terraform.tfvars

# Region for the state bucket. Every lab must be initialised against this same
# Region -- an S3 backend is Region-specific.
aws_region = "ap-southeast-1"

# Prefix for resource names and the Project tag. Becomes part of the bucket name.
project_name = "awsnet"

# Leave commented out to get "<project_name>-tfstate-<random suffix>", which is
# what you want: S3 bucket names are globally unique across every AWS account.
# state_bucket_name = "my-org-terraform-state-labs"

# SSE-S3 (free) is the default. Set to true only if you want to practise KMS key
# policies -- a customer-managed key costs roughly USD 1/month.
# create_kms_key = false

# Keep 90 days of superseded state versions. Set to 0 to keep them forever.
# noncurrent_version_expiration_days = 90

# Strongly recommended for a learning account: an email the moment spend moves.
# AWS sends each address a subscription confirmation you must accept.
# enable_budget              = true
# budget_limit_usd           = 20
# budget_notification_emails = ["you@example.com"]

# additional_tags = {
#   Owner = "your-name"
# }
