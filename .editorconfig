root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# `terraform fmt` uses two spaces; keep editors from fighting it.
[*.{tf,tfvars,hcl}]
indent_style = space
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.sh]
indent_size = 2
